<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plug"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/ipEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Local IP address"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/localKeyEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Local Key"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detection"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Power Threshold (W)"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/offThresholdEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="10"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duration (s)"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/debounceEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="90"
            android:inputType="number"
            android:singleLine="true"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cycle finished notification text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/alertTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title (e.g. Cycle finished)"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/alertMessageEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Message (e.g. The appliance has finished)"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE" />

    </LinearLayout>
</ScrollView>
